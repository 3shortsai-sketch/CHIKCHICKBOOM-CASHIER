rules_version = '2';

// Only the booth account(s) can read or write. Everyone else, including
// anyone who creates their own account with the app's (public) config, is
// refused. Put the booth login email(s) in the list below.
service cloud.firestore {
  match /databases/{database}/documents {
    function isBooth() {
      return request.auth != null
        && request.auth.token.email in ['BOOTH_EMAIL_GOES_HERE'];
    }

    match /settings/{docId} {
      allow read, write: if isBooth() && docId == 'main';
    }
    match /days/{dayId} {
      allow read, write: if isBooth();
    }
    match /orders/{orderId} {
      allow read, write: if isBooth();
    }
    match /cards/{cardId} {
      allow read, write: if isBooth();
    }
    match /cashMoves/{moveId} {
      allow read, write: if isBooth();
    }
    // Customer page: anyone may look up ONE document by its exact id, but
    // nobody may list them. Stored here: an order's number, first name,
    // status and how many items are done; a Boom Card's stamps (no name);
    // a voucher's value and whether it was used. No money, no full names.
    match /tracker/{trackId} {
      allow get: if true;
      allow list: if false;
      allow write: if isBooth();
    }
    match /public/{docId} {
      allow get: if true;
      allow list: if false;
      allow write: if isBooth() && docId in ['booth-live', 'booth-demo'];
    }
    // Anything else: no access.
  }
}
