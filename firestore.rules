rules_version = '2';

// Only the booth account(s) can read or write. Everyone else, including
// anyone who creates their own account with the app's (public) config, is
// refused. Put the booth login email(s) in the list below.
service cloud.firestore {
  match /databases/{database}/documents {
    function isBooth() {
      return request.auth != null
        && request.auth.token.email in ['BOOTH_EMAIL_GOES_HERE'];
    }

    match /settings/{docId} {
      allow read, write: if isBooth() && docId == 'main';
    }
    match /days/{dayId} {
      allow read, write: if isBooth();
    }
    match /orders/{orderId} {
      allow read, write: if isBooth();
    }
    match /cards/{cardId} {
      allow read, write: if isBooth();
    }
    // Anything else: no access.
  }
}
